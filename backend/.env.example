NODE_ENV=development
PORT=8000

# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=aimb_token

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini (http://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash